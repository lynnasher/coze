# ============================================
# 刷题系统 - 环境变量配置示例
# 迁移到阿里云/其他服务器时请配置这些变量
# ============================================

# ----------------------------------------
# 1. Supabase 数据库配置（必需）
# ----------------------------------------
# 从你的 Supabase 项目设置中获取
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key-here
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 客户端兼容配置（同时设置）
NEXT_PUBLIC_COZE_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_COZE_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------
# 2. 后台管理安全配置（必需）
# ----------------------------------------
NEXT_PUBLIC_ADMIN_LOGIN_PATH=/dashboard/auth/secure-login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT Token 密钥（建议设置，避免重启后失效）
TOKEN_SECRET=your-random-secret-key-here

# ----------------------------------------
# 3. 其他可选配置
# ----------------------------------------
# 部署环境
COZE_PROJECT_ENV=PROD

# 端口（默认 5000）
DEPLOY_RUN_PORT=5000

# ----------------------------------------
# 4. 数据库导出支持
# ----------------------------------------
# 支持导出以下表:
#   - users (用户账号)
#   - admin_users (后台管理员)
#   - activation_codes (激活码)
#   - user_activations (用户激活记录)
#   - user_data (用户数据)
#   - categories (分类)
#   - question_banks (题库)
#   - questions (题目)
#   - health_check (健康检查)

# ----------------------------------------
# 4. 阿里云短信服务配置（可选）
# ----------------------------------------
# 如需使用真实短信验证码，请配置以下变量
# 购买链接：https://www.aliyun.com/product/sms
#
# AccessKey 获取：阿里云控制台 → 头像 → AccessKey 管理
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 短信认证套餐包使用以下固定值（无需修改）
ALIYUN_SMS_SIGN_NAME=阿里云短信测试
ALIYUN_SMS_TEMPLATE_CODE=SMS_215071136
#
# 不配置时保持测试模式（控制台输出验证码）
# 配置后启用真实短信发送（从套餐包扣费）
# 费用约 0.05元/条，具体以阿里云官网为准

# ----------------------------------------
# 5. 其他可选配置
# ----------------------------------------
# 部署环境
COZE_PROJECT_ENV=PROD

# 端口（默认 5000）
DEPLOY_RUN_PORT=5000

# ----------------------------------------
# 6. 数据库导出支持
# ----------------------------------------
# 支持导出以下表:
#   - users (用户账号)
#   - admin_users (后台管理员)
#   - activation_codes (激活码)
#   - user_activations (用户激活记录)
#   - user_data (用户数据)
#   - categories (分类)
#   - question_banks (题库)
#   - questions (题目)
#   - health_check (健康检查)
